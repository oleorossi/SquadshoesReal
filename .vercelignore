# O Vercel precisa: package.json, vite.config.ts, tsconfig*, src/, public/,
# index.html, vercel.json, scripts/ (chamados pelo `npm run build`).
# Aqui ficam os arquivos de PESO MORTO que não compõem build.

# Bundles e assets pesados na raiz
*.zip
*.tar.gz
AGL_001.TXT

# Documentação interna (auditorias, planos, READMEs longos) — não vai pra build
*.md
!README.md
INSTRUCOES.md

# Backups e configs locais
.env.backup_pre_supabase_switch
.gitlab-ci.yml

# Migrations + edge functions ficam no Supabase, não no Vercel
supabase/

# Diretórios auxiliares que não entram no build do app
sql-scripts/
docs/
.claude/
.codex/

# Arquivos JSX/TSX soltos na raiz (legacy, não importados pelo src/)
App.tsx
Navigation.test.tsx
NavigationAccessConsistency.test.ts
SecurityIntegration.test.tsx

# Sempre úteis
.git/
node_modules/
dist/
dist-ssr/
